# ---- Intuit OAuth app credentials ----
# Create an app at https://developer.intuit.com/app/developer/myapps
# Under "Keys & OAuth", grab the client ID and secret for the environment you want.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# sandbox | production
INTUIT_ENVIRONMENT=sandbox

# ---- Public base URL ----
# Where this server is reachable from the browser doing the OAuth dance.
# This URL is sent to Intuit as the redirect host, so it MUST match a redirect URI
# registered in your Intuit app settings.
# Examples:
#   http://localhost:3000                (pure local)
#   http://<machine>.<tailnet>.ts.net:3000   (Tailscale MagicDNS)
PUBLIC_BASE_URL=http://localhost:3000

# ---- Storage ----
DATABASE_PATH=/app/data/qbo-mcp.sqlite

# ---- HTTP bind ----
PORT=3000
HOST=0.0.0.0

# ---- Team auth ----
# Shared secret your coworkers paste at /team-signup to mint themselves a
# personal Bearer key. Don't commit this. Rotate by changing + restart.
# If unset, /team-signup is disabled and only the admin can use the MCP.
TEAM_SIGNUP_TOKEN=

# Shared secret guarding /connect/quickbooks (the admin-only Intuit OAuth
# bootstrap). Distribute to whoever should be allowed to (re)link the QBO
# admin slot. If unset, anyone who reaches the server URL can become the
# QBO admin and revoke everyone else's Intuit tokens — strongly recommend
# setting this.
ADMIN_BOOTSTRAP_TOKEN=

# ---- Cloudflare Access (optional, recommended) ----
# When BOTH are set, /oauth/authorize and /team-signup will auto-pass for
# users whose request carries a valid Cf-Access-Jwt-Assertion header (i.e.
# their browser was authenticated through a Cloudflare Access policy you
# configured — e.g. allow @ditto.com Google logins). The user's email is
# read from the JWT and stored as the user's label. Fall-back is the team
# token form (TEAM_SIGNUP_TOKEN above).
#
# CF_ACCESS_TEAM_DOMAIN: your team's Cloudflare Zero Trust domain.
#   e.g. erel.cloudflareaccess.com
# CF_ACCESS_AUD: the per-application AUD tag from the Access app config.
#   Found in Zero Trust dashboard → Access → Applications → <app> → Overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Email of the admin user. When a Cf-Access-Jwt-Assertion is present and its
# email matches, /admin renders. Otherwise the admin must pass
# ADMIN_BOOTSTRAP_TOKEN as ?token=… on /admin URLs.
ADMIN_EMAIL=
