# ---- Intuit OAuth app credentials ----
# Create an app at https://developer.intuit.com/app/developer/myapps
# Under "Keys & OAuth", grab the client ID and secret for the environment you want.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

# sandbox | production
INTUIT_ENVIRONMENT=sandbox

# ---- Public base URL ----
# Where this server is reachable from the browser doing the OAuth dance.
# This URL is sent to Intuit as the redirect host, so it MUST match a redirect URI
# registered in your Intuit app settings.
# Examples:
#   http://localhost:3000                (pure local)
#   http://<machine>.<tailnet>.ts.net:3000   (Tailscale MagicDNS)
PUBLIC_BASE_URL=http://localhost:3000

# ---- Storage ----
DATABASE_PATH=/app/data/qbo-mcp.sqlite

# ---- HTTP bind ----
PORT=3000
HOST=0.0.0.0

# ---- Team auth ----
# Shared secret your coworkers paste at /team-signup to mint themselves a
# personal Bearer key. Don't commit this. Rotate by changing + restart.
# If unset, /team-signup is disabled and only the admin can use the MCP.
TEAM_SIGNUP_TOKEN=

# Shared secret guarding /connect/quickbooks (the admin-only Intuit OAuth
# bootstrap). Distribute to whoever should be allowed to (re)link the QBO
# admin slot. If unset, anyone who reaches the server URL can become the
# QBO admin and revoke everyone else's Intuit tokens — strongly recommend
# setting this.
ADMIN_BOOTSTRAP_TOKEN=
